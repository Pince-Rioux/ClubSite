@page "/admin/mitglieder"
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@model ClubSite.Pages.ManageMembersModel
@{
    ViewData["Title"] = "Mitgliederverwaltung";

    HttpContext.Response.Headers.Remove("Cache-Control");
    HttpContext.Response.Headers.Remove("Pragma");
    HttpContext.Response.Headers.TryAdd("Cache-Control", "no-store, no-cache, must-revalidate");
    HttpContext.Response.Headers.TryAdd("Pragma", "no-cache");
}

<div class="mx-3 pt-2 pb-4">
    <h1>Mitgliederverwaltung</h1>

    @if (Model.StatusMessage is string msg)
    {
        <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
        </div>
    }

    @if (Model.Members.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Es sind noch keine Mitglieder registriert.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>E-Mail</th>
                        <th>Mitgliedsnummer</th>
                        <th>Telefon</th>
                        <th>Status</th>
                        <th>Beitritt</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>@member.Name</td>
                            <td>@member.Email</td>
                            <td><code>@member.MembershipNumber</code></td>
                            <td>@member.Phone</td>
                            <td>
                                @if (member.Status == "Aktiv")
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@member.Status</span>
                                }
                            </td>
                            <td>@member.MemberSince</td>
                            <td>
                                <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                    <input type="hidden" name="userId" value="@member.Id" />
                                    @if (member.Status == "Aktiv")
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Mitglied wirklich deaktivieren?')">
                                            Deaktivieren
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Reaktivieren
                                        </button>
                                    }
                                </form>
                                <form method="post" asp-page-handler="Delete" class="d-inline ms-1">
                                    <input type="hidden" name="userId" value="@member.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Mitglied endgültig löschen? Diese Aktion kann nicht rückgängig gemacht werden.')">
                                        Löschen
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small">
            Insgesamt @Model.Members.Count Mitglieder
        </p>
    }

    <a href="/" class="btn btn-outline-secondary mt-3">Zurück zur Startseite</a>
</div>