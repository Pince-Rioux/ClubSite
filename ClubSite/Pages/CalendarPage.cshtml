@page
@model ClubSite.Pages.CalendarPageModel
@{
    ViewData["Title"] = "Termine";
}
<div class="mx-3 py-2">
    <div>
        <h2 class="h2">@ViewData["Title"]</h2>
        <h4 class="h4">Spieltage, Training &amp; Vereinstermine</h4>
        <hr />
    </div>

    @if (!Model.HasIcsFiles)
    {
        <div class="alert alert-info" role="alert">
            Der Terminkalender wird aktuell noch befüllt.
        </div>
    }
    else
    {
        <form method="get" class="row g-3 mb-4 align-items-end" role="form">
            <div class="col-md-3">
                <label asp-for="TeamFilter" class="form-label">Team</label>
                <select asp-for="TeamFilter" class="form-select">
                    <option value="">Alle Teams</option>
                    @foreach (var team in Model.AvailableTeams)
                    {
                        <option value="@team">@team</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="CategoryFilter" class="form-label">Kategorie</label>
                <select asp-for="CategoryFilter" class="form-select">
                    <option value="">Alle Kategorien</option>
                    @foreach (var category in Model.AvailableCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Mode" class="form-label">Zeitraum</label>
                <select asp-for="Mode" class="form-select">
                    <option value="upcoming">Anstehende Termine</option>
                    <option value="past">Vergangene Termine</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Filtern</button>
            </div>
        </form>

        @if (Model.Events.Count == 0)
        {
            <div class="alert alert-secondary" role="alert">
                Keine Termine für die gewählten Filter.
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var evt in Model.Events)
                {
                    <div class="list-group-item d-flex flex-wrap align-items-center py-3">
                        <div class="col-2 col-md-1 text-center me-3">
                            <div class="fw-bold text-primary">@evt.StartDate.ToString("dd.MM.")</div>
                            <div class="small text-muted">@evt.StartDate.ToString("yyyy")</div>
                            <div class="small text-muted">@evt.StartDate.ToString("HH:mm")</div>
                        </div>
                        <div class="col-9 col-md-8">
                            <div class="fw-semibold">@evt.Title</div>
                            @if (!string.IsNullOrEmpty(evt.Location))
                            {
                                <div class="small text-muted"><i class="fas fa-map-marker-alt me-1"></i>@evt.Location</div>
                            }
                            @if (!string.IsNullOrEmpty(evt.Description))
                            {
                                <div class="small text-muted mt-1">@evt.Description</div>
                            }
                        </div>
                        <div class="col-12 col-md-2 text-md-end mt-2 mt-md-0">
                            @if (!string.IsNullOrEmpty(evt.Team))
                            {
                                <span class="badge bg-primary rounded-pill me-1">@evt.Team</span>
                            }
                            @if (!string.IsNullOrEmpty(evt.Category))
                            {
                                <span class="badge bg-secondary rounded-pill">@evt.Category</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>