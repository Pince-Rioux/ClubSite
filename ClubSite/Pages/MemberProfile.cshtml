@page "/mein-profil"
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@model ClubSite.Pages.MemberProfileModel
@{
    ViewData["Title"] = "Mein Profil";

    HttpContext.Response.Headers.Remove("Cache-Control");
    HttpContext.Response.Headers.Remove("Pragma");
    HttpContext.Response.Headers.TryAdd("Cache-Control", "no-store, no-cache, must-revalidate");
    HttpContext.Response.Headers.TryAdd("Pragma", "no-cache");
}

<div class="mx-3 pt-2 pb-4">
    <h1>Mein Profil</h1>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Mitgliedschaft</h5>
                    <dl class="mb-0">
                        <dt>Mitgliedsnummer</dt>
                        <dd>@Model.MembershipNumber</dd>
                        <dt>E-Mail</dt>
                        <dd>@Model.Email</dd>
                        <dt>Mitglied seit</dt>
                        <dd>@Model.MemberSince</dd>
                        <dt>Status</dt>
                        <dd>
                            @if (Model.Status == "Aktiv")
                            {
                                <span class="badge bg-success">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.Status</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Persönliche Daten bearbeiten</h5>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.FirstName" class="form-label"></label>
                            <input asp-for="Input.FirstName" class="form-control" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.LastName" class="form-label"></label>
                            <input asp-for="Input.LastName" class="form-control" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" type="tel" />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4">Adresse</h5>
                        <hr />

                        <div class="mb-3">
                            <label asp-for="Input.HomeAddress" class="form-label"></label>
                            <input asp-for="Input.HomeAddress" class="form-control" />
                            <span asp-validation-for="Input.HomeAddress" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label asp-for="Input.ZipCode" class="form-label"></label>
                                <input asp-for="Input.ZipCode" class="form-control" />
                                <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
                            </div>
                            <div class="col-md-7 mb-3">
                                <label asp-for="Input.City" class="form-label"></label>
                                <input asp-for="Input.City" class="form-control" />
                                <span asp-validation-for="Input.City" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.State" class="form-label"></label>
                            <input asp-for="Input.State" class="form-control" />
                            <span asp-validation-for="Input.State" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4">Weitere Angaben (optional)</h5>
                        <hr />

                        <div class="mb-3">
                            <label asp-for="Input.EmergencyContact" class="form-label"></label>
                            <textarea asp-for="Input.EmergencyContact" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.EmergencyContact" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.SpecialNeeds" class="form-label"></label>
                            <textarea asp-for="Input.SpecialNeeds" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.SpecialNeeds" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Speichern</button>
                            <a href="/" class="btn btn-outline-secondary ms-2">Zurück</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>